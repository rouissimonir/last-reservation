# Copy to .env (git-ignored). Public values only: these are inlined into the app bundle.
# Never put RevenueCat secret keys, App Store .p8 keys or Google service-account JSON here.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_SUPPORT_URL=
EXPO_PUBLIC_PRIVACY_URL=
# Development only. Opens After Midnight cases without a purchase in a __DEV__ bundle; ignored by release builds.
EXPO_PUBLIC_DEV_PREVIEW_PREMIUM=
