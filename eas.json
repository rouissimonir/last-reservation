{
  "cli": { "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": { "EXPO_PUBLIC_DEV_PREVIEW_PREMIUM": "0" }
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_DEV_PREVIEW_PREMIUM": "0" }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6824306758",
        "sku": "TWOSIDES_IOS_001"
      }
    }
  }
}
